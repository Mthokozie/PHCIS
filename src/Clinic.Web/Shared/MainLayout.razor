@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject IPatientService PatientService
@inject NavigationManager Navigation

@if (!_authChecked)
{
    <MudLayout>
        <MudMainContent Class="d-flex align-center justify-center" Style="min-height: 100vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </MudMainContent>
    </MudLayout>
}
else if (!_isAuthenticated)
{
    @if (IsPublicAuthRoute())
    {
        <MudLayout>
            <MudMainContent Style="min-height: 100vh; background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);" Class="pa-0">
                @Body
            </MudMainContent>
        </MudLayout>
    }
}
else
{
    <MudLayout>
        <MudAppBar Elevation="2" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="ml-2 mr-1" />
            <MudText Typo="Typo.h6" Style="font-weight:700;">PHCIS Clinic Booking</MudText>
            <MudSpacer />
            <MudButton Color="Color.Inherit" OnClick="@(() => Navigation.NavigateTo("/my-appointments"))">My Appointments</MudButton>
            <MudTooltip Text="Edit My Profile & Photo">
                <MudIconButton OnClick="@(() => Navigation.NavigateTo("/profile"))" Class="ml-1">
                    <MudAvatar Size="Size.Small" Color="Color.Secondary">
                        @if (!string.IsNullOrEmpty(_patient?.ProfileImageUrl))
                        {
                            <MudImage Src="@_patient.ProfileImageUrl" Alt="Avatar" Style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        }
                    </MudAvatar>
                </MudIconButton>
            </MudTooltip>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Class="ml-2" OnClick="LogoutAsync">Sign Out</MudButton>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
            <NavMenu IsAuthenticated="_isAuthenticated" />
        </MudDrawer>

        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _authChecked;
    private bool _isAuthenticated;
    private PatientDto? _patient;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckAuthAndRedirectAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthAndRedirectAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckAuthAndRedirectAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsPublicAuthRoute()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
        return relativePath == "login" || relativePath == "register";
    }

    private async Task CheckAuthAndRedirectAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        _authChecked = true;

        if (!_isAuthenticated)
        {
            _patient = null;
            if (!IsPublicAuthRoute())
            {
                Navigation.NavigateTo("/login", replace: true);
            }
            return;
        }

        if (_patient is null)
        {
            var patientId = await AuthService.GetPatientIdAsync();
            if (patientId.HasValue && patientId.Value != Guid.Empty)
            {
                _patient = await PatientService.GetPatientByIdAsync(patientId.Value);
            }
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        _isAuthenticated = false;
        _patient = null;
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
