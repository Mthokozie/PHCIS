@page "/"
@inject IClinicService ClinicService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>PHCIS Clinic Booking - Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="phcis-page-container">
    <!-- Hero Section -->
    <MudPaper Elevation="0" Class="phcis-hero mb-6 mud-theme-primary" Style="background: linear-gradient(135deg, #1976D2 0%, #42A5F5 100%);">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h4" Style="color:white; font-weight:700;">Welcome to PHCIS Clinic Booking</MudText>
                <MudText Typo="Typo.subtitle1" Style="color:rgba(255,255,255,0.9);" Class="mt-2 mb-5">
                    Book appointments at your nearest uMkhanyakude District clinic quickly and conveniently.
                </MudText>
                <div class="d-flex flex-wrap gap-3">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Large"
                               Style="background:white; color:#1976D2; font-weight:600;"
                               OnClick="@(() => Navigation.NavigateTo("/book"))">
                        Book an Appointment
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Large"
                               Style="color:white; border-color:white;"
                               OnClick="@(() => Navigation.NavigateTo("/dashboard"))">
                        My Dashboard
                    </MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-none d-md-flex align-center justify-center">
                <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Style="font-size:7rem; color:rgba(255,255,255,0.3);" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Feature Cards -->
    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:600;">Our Services</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Style="border-radius:12px; height:100%;">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Primary" Style="font-size:3rem;" />
                    <MudText Typo="Typo.h6" Class="mt-3 mb-2" Style="font-weight:600;">Book Appointment</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Schedule your clinic visit in just a few steps. Choose your preferred clinic, date, and time.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/book"))">
                        Book Now
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Style="border-radius:12px; height:100%;">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Secondary" Style="font-size:3rem;" />
                    <MudText Typo="Typo.h6" Class="mt-3 mb-2" Style="font-weight:600;">View Available Clinics</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Browse all registered uMkhanyakude District clinics, view their operating hours, and find one near you.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => Navigation.NavigateTo("/book"))">
                        Browse Clinics
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Style="border-radius:12px; height:100%;">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Success" Style="font-size:3rem;" />
                    <MudText Typo="Typo.h6" Class="mt-3 mb-2" Style="font-weight:600;">Manage Appointments</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        View, cancel, or reschedule your existing appointments with ease.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4">
                    <MudButton Variant="Variant.Filled" Style="background:#4CAF50; color:white;" OnClick="@(() => Navigation.NavigateTo("/my-appointments"))">
                        My Appointments
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Active Clinics QuickGrid Section -->
    <MudCard Elevation="3" Class="phcis-card mt-8">
        <div class="phcis-toolbar">
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:600;">Available uMkhanyakude District Clinics</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Browse clinics with sorting and customizable pagination</MudText>
            </div>
            <div class="phcis-toolbar-controls">
                <MudTextField @bind-Value="_clinicSearch"
                              Placeholder="Search clinic name or address..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="phcis-search-input" />

                <MudSelect T="int"
                           Label="Show per page"
                           Value="_clinicPagination.ItemsPerPage"
                           ValueChanged="OnClinicPageSizeChangedAsync"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="phcis-pagesize-select">
                    <MudSelectItem Value="3">3 per page</MudSelectItem>
                    <MudSelectItem Value="5">5 per page</MudSelectItem>
                    <MudSelectItem Value="10">10 per page</MudSelectItem>
                    <MudSelectItem Value="20">20 per page</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <div class="phcis-quickgrid-wrapper">
            <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@FilteredClinics" Pagination="@_clinicPagination">
                <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Name)" Title="Clinic Name" Sortable="true" />
                <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Address)" Title="Address / Area" Sortable="true" />
                <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Operating Hours" Sortable="true" SortBy="@(Microsoft.AspNetCore.Components.QuickGrid.GridSort<ClinicDto>.ByAscending(c => c.OpeningTime))">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                        @context.OpeningTime – @context.ClosingTime
                    </MudChip>
                </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
                <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Phone)" Title="Phone" />
                <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Action">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CalendarMonth"
                               OnClick="@(() => Navigation.NavigateTo($"/book?ClinicId={context.Id}"))">
                        Book Here
                    </MudButton>
                </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
            </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
        </div>

        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@_clinicPagination" />
    </MudCard>
</MudContainer>

@code {
    private List<ClinicDto> _clinics = new();
    private string _clinicSearch = string.Empty;
    private readonly Microsoft.AspNetCore.Components.QuickGrid.PaginationState _clinicPagination = new() { ItemsPerPage = 5 };

    private IQueryable<ClinicDto> FilteredClinics =>
        _clinics
            .Where(c => string.IsNullOrWhiteSpace(_clinicSearch)
                || c.Name.Contains(_clinicSearch, StringComparison.OrdinalIgnoreCase)
                || c.Address.Contains(_clinicSearch, StringComparison.OrdinalIgnoreCase))
            .AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        _clinics = await ClinicService.GetAllClinicsAsync();
    }

    private async Task OnClinicPageSizeChangedAsync(int newSize)
    {
        _clinicPagination.ItemsPerPage = newSize;
        await _clinicPagination.SetCurrentPageIndexAsync(0);
    }
}
