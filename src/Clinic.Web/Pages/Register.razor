@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Patient Registration - PHCIS Clinic Booking</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudCard Elevation="4" Class="pa-6" Style="border-radius: 12px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight:700;">Patient Registration</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Create your PHCIS patient profile to book appointments</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <!-- Profile Picture Upload & Preview -->
            <div class="d-flex flex-column align-center mb-6">
                <MudAvatar Style="height:96px; width:96px; font-size:2rem;" Color="Color.Primary" Class="mb-3">
                    @if (!string.IsNullOrEmpty(_model.ProfileImageUrl))
                    {
                        <MudImage Src="@_model.ProfileImageUrl" Alt="Profile Preview" Style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                    }
                </MudAvatar>

                <div class="d-flex gap-2 align-center">
                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp" FilesChanged="OnProfileImageSelectedAsync" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PhotoCamera">
                                @(string.IsNullOrEmpty(_model.ProfileImageUrl) ? "Upload Profile Photo (Optional)" : "Change Photo")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (!string.IsNullOrEmpty(_model.ProfileImageUrl))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => _model.ProfileImageUrl = null)" />
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">JPG, PNG or WebP (auto-resized to 256×256)</MudText>
            </div>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.FirstName" Label="First Name" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.LastName" Label="Last Name" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Email" Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Email" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Password" Label="Password (min 6 chars, uppercase, digit, symbol)" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.PhoneNumber" Label="Phone Number" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.IdNumber" Label="National ID Number" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker Label="Date of Birth" @bind-Date="_dob" Variant="Variant.Outlined" MaxDate="@DateTime.Today.AddDays(-1)" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions Class="d-flex flex-column px-4 pb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_isSubmitting"
                       OnClick="HandleRegisterAsync">
                @(_isSubmitting ? "Registering..." : "Create Account")
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Class="mt-2"
                       OnClick="@(() => Navigation.NavigateTo("/login"))">
                Already registered? Sign In
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private readonly RegisterRequest _model = new();
    private DateTime? _dob = new DateTime(1990, 1, 1);
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task OnProfileImageSelectedAsync(IBrowserFile? file)
    {
        if (file is null)
            return;

        try
        {
            var resizedFile = await file.RequestImageFileAsync("image/jpeg", 256, 256);
            using var stream = resizedFile.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            _model.ProfileImageUrl = $"data:image/jpeg;base64,{base64}";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not process image: {ex.Message}", Severity.Warning);
        }
    }

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;
        _model.DateOfBirth = _dob ?? new DateTime(1990, 1, 1);

        _isSubmitting = true;
        var (success, error) = await AuthService.RegisterAsync(_model);
        if (success)
        {
            await AuthService.LoginAsync(new LoginRequest { Email = _model.Email, Password = _model.Password });
            Snackbar.Add("Account created and signed in!", Severity.Success);
            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        else
        {
            _errorMessage = error ?? "Registration failed. Please check your details.";
        }
        _isSubmitting = false;
    }
}
